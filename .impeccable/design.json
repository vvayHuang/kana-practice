  "narrative": {
    "northStar": "The Practice Sheet",
    "overview": "The whole page is one sheet of white practice paper. Everything the learner reads is written in ink. Colour is kept for answer status: vermilion where something was wrong, green where an answer was right. A single ink band across the top carries the two tabs and the sound button; there is no logo or product name in it.\n\nThe kana is the subject. It sits in a ruled practice cell with dashed centre guides, the same cell whether it is one of 46 in the chart, a missed kana in the results, or the single large character of a quiz question. Controls stay plain: a selected thing is filled with ink, an unselected thing is an outline.",
    "keyCharacteristics": [
      "White paper page, ink marks, status colour only on answers, one ink band at the top",
      "Square corners (2px) and ruled tables instead of cards and shadows",
      "Kana always in a guided cell",
      "Selection shown by ink fill, never by colour",
      "One-thumb reach: the primary action sits at the bottom of the screen"
    ],
    "rules": [
      {
        "name": "The Status Only Rule",
        "body": "Vermilion means \"this was wrong\" and green means \"this was right\". Neither is used for brand, emphasis, links, primary buttons or selection.",
        "section": "colors"
      },
      {
        "name": "The Ink Fill Rule",
        "body": "Selected, current and primary are shown by filling with ink and reversing the text to paper. Colour does not carry selection.",
        "section": "colors"
      },
      {
        "name": "The Model Hand Rule",
        "body": "Kana is always set in Klee One at weight 600. Never substitute a Mincho or Gothic face for kana a learner is meant to copy.",
        "section": "typography"
      },
      {
        "name": "The Lying Flat Rule",
        "body": "If it scrolls with the page it has no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the page white paper and let ruled tables and space separate sections.",
      "Do show kana in a guided practice cell.",
      "Do show selection with ink fill.",
      "Do keep the main action within thumb reach at the bottom of the screen.",
      "Do keep text on paper at Ink Tertiary (#5d6370) or darker."
    ],
    "donts": [
      "Don't use vermilion for anything except marking something wrong, or green for anything except marking an answer right.",
      "Don't add rounded cards, soft shadows on resting surfaces, a cream ground, or a coloured ground behind the paper in the light theme.",
      "Don't put a logo or the product name back in the header band.",
      "Don't set kana in any face other than Klee One."
    ]
  }
}