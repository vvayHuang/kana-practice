  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a sheet or sticky bar.",
      "html": "<button class=\"ds-btn-primary\">開始測驗</button>",
      "css": ".ds-btn-primary{min-height:48px;padding:0 20px;border:1px solid var(--ink);border-radius:2px;background:var(--ink);color:var(--paper);font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:17px;cursor:pointer;transition:transform .1s}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action on paper.",
      "html": "<button class=\"ds-btn-outline\">再來一輪</button>",
      "css": ".ds-btn-outline{min-height:48px;padding:0 20px;border:1px solid var(--ink);border-radius:2px;background:transparent;color:var(--ink);font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:17px;cursor:pointer;transition:background-color .15s}.ds-btn-outline:hover{background:var(--paper-2)}.ds-btn-outline:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Segments",
      "kind": "input",
      "refersTo": "segment-selected",
      "description": "Pick one of two or three; the chosen cell is ink-filled.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">平假名</button><button aria-pressed=\"false\">片假名</button></div>",
      "css": ".ds-seg{display:inline-grid;grid-auto-flow:column;grid-auto-columns:1fr;border:1px solid var(--ink);border-radius:2px}.ds-seg button{border:0;background:transparent;padding:6px 10px;min-height:44px;font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:15px;color:var(--ink);cursor:pointer}.ds-seg button+button{border-left:1px solid var(--ink)}.ds-seg button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.ds-seg button[aria-pressed=false]:hover{background:var(--paper-2)}"
    },
    {
      "name": "Tabs in the ink band",
      "kind": "nav",
      "refersTo": "tab-current",
      "description": "Top-level navigation; the current tab is a paper block.",
      "html": "<nav class=\"ds-tabs\"><a aria-current=\"page\" href=\"#\">五十音表</a><a href=\"#\">測驗</a></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:1fr 1fr;width:240px;border:1px solid var(--on-band-2);border-radius:2px;background:var(--band)}.ds-tabs a{display:flex;align-items:center;justify-content:center;min-height:44px;color:var(--on-band);text-decoration:none;font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:16px}.ds-tabs a[aria-current=page]{background:var(--paper);color:var(--ink)}.ds-tabs a:not([aria-current]):hover{background:var(--band-2)}"
    },
    {
      "name": "Practice cell",
      "kind": "custom",
      "refersTo": "sheet",
      "description": "A kana in a guided cell with romaji and a mastery mark.",
      "html": "<button class=\"ds-cell\"><span class=\"ds-cell-k\" lang=\"ja\">あ</span><span class=\"ds-cell-r\">a</span></button>",
      "css": ".ds-cell{position:relative;width:72px;height:72px;display:grid;place-items:center;padding:0 0 14px;border:1.5px solid var(--ink);border-radius:0;color:var(--ink);cursor:pointer;background:repeating-linear-gradient(90deg,var(--guide) 0 3px,transparent 3px 7px) center/100% 1px no-repeat,repeating-linear-gradient(0deg,var(--guide) 0 3px,transparent 3px 7px) center/1px 100% no-repeat,var(--paper)}.ds-cell:hover{background-color:var(--paper-2)}.ds-cell-k{font-family:'Klee One',serif;font-weight:600;font-size:30px;line-height:1}.ds-cell-r{position:absolute;left:0;right:0;bottom:3px;font-size:12px;line-height:1;color:var(--ink-2)}.ds-cell::after{content:'';position:absolute;left:4px;bottom:4px;width:9px;height:9px;border-radius:50%;background:var(--ink)}"
