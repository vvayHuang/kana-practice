  "narrative": {
    "northStar": "The Calligraphy Desk",
    "overview": "The screen is a desk set for writing practice. A navy felt mat is the ground. White sheets of paper lie on it with square corners and no shadow. Everything the learner reads is written in ink, and the only other colour is the teacher's vermilion pen, which appears where an answer was wrong and nowhere else.\n\nThe kana is the subject. It sits in a ruled practice cell with dashed centre guides, the same cell whether it is one of 46 in the chart, a missed kana in the results, or the single large character of a quiz question. Controls stay plain: a selected thing is filled with ink, an unselected thing is an outline.",
    "keyCharacteristics": [
      "Felt ground, paper sheets, ink marks, vermilion corrections",
      "Square corners (2px) and hairline rules instead of cards and shadows",
      "Kana always in a guided cell",
      "Selection shown by ink fill, never by colour",
      "One-thumb reach: the primary action sits at the bottom of the screen"
    ],
    "rules": [
      {
        "name": "The Red Pen Rule",
        "body": "Vermilion means \"this was wrong\". It is never used for brand, emphasis, links, primary buttons or selection.",
        "section": "colors"
      },
      {
        "name": "The Ink Fill Rule",
        "body": "Selected, current and primary are shown by filling with ink and reversing the text to paper. Colour does not carry selection.",
        "section": "colors"
      },
      {
        "name": "The Model Hand Rule",
        "body": "Kana is always set in Klee One at weight 600. Never substitute a Mincho or Gothic face for kana a learner is meant to copy.",
        "section": "typography"
      },
      {
        "name": "The Lying Flat Rule",
        "body": "If it scrolls with the page it has no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put content on a paper sheet and controls that belong to the whole screen on the felt.",
      "Do show kana in a guided practice cell.",
      "Do show selection with ink fill.",
      "Do keep the main action within thumb reach at the bottom of the screen.",
      "Do keep text on paper at Ink Tertiary (#5d6370) or darker."
    ],
    "donts": [
      "Don't use vermilion for anything except marking something wrong.",
      "Don't add rounded cards, soft shadows on resting surfaces, or a cream ground.",
      "Don't add green for success; a right answer is marked in ink.",
      "Don't set kana in any face other than Klee One."
    ]
  }
}