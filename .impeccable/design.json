      "html": "<button class=\"ds-cell\"><span class=\"ds-cell-k\" lang=\"ja\">あ</span><span class=\"ds-cell-r\">a</span></button>",
      "css": ".ds-cell{position:relative;width:72px;height:72px;display:grid;place-items:center;padding:0 0 14px;border:1.5px solid var(--ink);border-radius:0;color:var(--ink);cursor:pointer;background:repeating-linear-gradient(90deg,var(--guide) 0 3px,transparent 3px 7px) center/100% 1px no-repeat,repeating-linear-gradient(0deg,var(--guide) 0 3px,transparent 3px 7px) center/1px 100% no-repeat,var(--paper)}.ds-cell:hover{background-color:var(--paper-2)}.ds-cell-k{font-family:'Klee One',serif;font-weight:600;font-size:30px;line-height:1}.ds-cell-r{position:absolute;left:0;right:0;bottom:3px;font-size:12px;line-height:1;color:var(--ink-2)}.ds-cell::after{content:'';position:absolute;left:4px;bottom:4px;width:9px;height:9px;border-radius:50%;background:var(--ink)}"
