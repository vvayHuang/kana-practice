      "html": "<button class=\"ds-btn-outline\">再來一輪</button>",
      "css": ".ds-btn-outline{min-height:48px;padding:0 20px;border:1px solid var(--ink);border-radius:2px;background:transparent;color:var(--ink);font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:17px;cursor:pointer;transition:background-color .15s}.ds-btn-outline:hover{background:var(--paper-2)}.ds-btn-outline:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Segments",
      "kind": "input",
      "refersTo": "segment-selected",
      "description": "Pick one of two or three; the chosen cell is ink-filled.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">平假名</button><button aria-pressed=\"false\">片假名</button></div>",
      "css": ".ds-seg{display:inline-grid;grid-auto-flow:column;grid-auto-columns:1fr;border:1px solid var(--ink);border-radius:2px}.ds-seg button{border:0;background:transparent;padding:6px 10px;min-height:44px;font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:15px;color:var(--ink);cursor:pointer}.ds-seg button+button{border-left:1px solid var(--ink)}.ds-seg button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.ds-seg button[aria-pressed=false]:hover{background:var(--paper-2)}"
    },
    {
      "name": "Tabs on felt",
      "kind": "nav",
      "refersTo": "tab-current",
      "description": "Top-level navigation; the current tab is a paper block.",
      "html": "<nav class=\"ds-tabs\"><a aria-current=\"page\" href=\"#\">五十音表</a><a href=\"#\">測驗</a></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:1fr 1fr;width:240px;border:1px solid var(--on-felt-2);border-radius:2px;background:var(--felt)}.ds-tabs a{display:flex;align-items:center;justify-content:center;min-height:44px;color:var(--on-felt);text-decoration:none;font-family:'LXGW WenKai TC','Klee One',serif;font-weight:700;font-size:16px}.ds-tabs a[aria-current=page]{background:var(--paper);color:var(--ink)}.ds-tabs a:not([aria-current]):hover{background:var(--felt-2)}"
    },
